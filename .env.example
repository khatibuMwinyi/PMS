# Database — Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Auth.js — generate with: openssl rand -hex 32
# Both names are accepted; AUTH_SECRET is the Auth.js v5 default.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Encryption key for at-rest field encryption — 32 bytes minimum
ENCRYPTION_SECRET=""

# Selcom Mobile Money (Future)
SELCOM_API_KEY=""
SELCOM_SECRET=""

# pg-boss job queue
PG_BOSS_CONNION_STRING=""
