generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis]
}

// ─── Core Enums ─────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  OWNER
  PROVIDER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum PropertyType {
  APARTMENT_BUILDING
  SINGLE_FAMILY
  TOWNHOUSE
  COMMERCIAL
}

enum PropertyStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum UnitType {
  APARTMENT
  HOUSE
  COMMERCIAL
}

enum PriceUnit {
  PER_SQM
  PER_UNIT
  FLAT
  PER_BEDROOM
}

enum ServiceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  ONE_TIME
}

enum QuoteStatus {
  DRAFT
  QUOTED
  ACCEPTED
  EXPIRED
}

enum AgreementStatus {
  QUOTED
  PENDING_ASSIGNMENT
  ACTIVE
  SUSPENDED
  CANCELLED
  COMPLETED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AssignmentStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  DISPUTED
  EXPIRED
  REJECTED
  CANCELLED_BY_OWNER
  CANCELLED_NO_SHOW
  AUTO_REASSIGNED
  NO_PROVIDER_AVAILABLE
}

enum TaskStatus {
  SCHEDULED
  NOTIFIED_24H
  NOTIFIED_1H
  IN_PROGRESS
  COMPLETED
  OVERDUE
  PENDING_REVIEW
  DISPUTED
  VERIFIED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  EXPIRED
}

enum DisputeResolution {
  PROVIDER_FAULT
  OWNER_FAULT
  SPLIT
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  ADJUSTMENT
  PENALTY
  REFUND
  COMPENSATION
}

enum TransactionStatus {
  PENDING
  SETTLED
  FAILED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  PAYMENT_RECEIVED
  PAYMENT_FAILED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  DISPUTE
  TECHNICAL
  PAYMENT
  ACCOUNT
  OTHER
}

enum UtilityType {
  WATER
  ELECTRICITY
  GAS
  WASTE
}

enum AllocationMethod {
  PER_UNIT
  PER_PERSON
  PER_SQM
}

// ─── Identity ───────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(PENDING_VERIFICATION)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt        @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  sessions             Session[]
  ownerProfile         OwnerProfile?
  providerProfile      ProviderProfile?
  quotes               Quote[]
  agreements           Agreement[]
  receivedNotifications Notification[]   @relation("NotificationRecipient")
  auditEvents          AuditEvent[]      @relation("AuditActor")

  @@index([role, status])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ─── Owner Side ─────────────────────────────────────────────────────

model OwnerProfile {
  id        String @id @default(uuid())
  userId    String @unique @map("user_id")
  user      User   @relation(fields: [userId], references: [id])
  firstName String @map("first_name")
  lastName  String @map("last_name")

  properties Property[]

  @@map("owner_profiles")
}

model Property {
  id               String          @id @default(uuid())
  ownerId          String          @map("owner_id")
  name             String
  type             PropertyType    @default(SINGLE_FAMILY)
  status           PropertyStatus  @default(PENDING)
  encryptedAddress String          @map("encrypted_address")
  zone             String
  location         Unsupported("geometry(Point, 4326)")?
  latitude         Float
  longitude        Float
  unitCount        Int             @default(1) @map("unit_count")
  imageUrls        String[]        @map("image_urls")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  owner       OwnerProfile  @relation(fields: [ownerId], references: [id])
  units       Unit[]
  assignments Assignment[]
  priceLocks  PriceLock[]
  quotes      Quote[]
  agreements  Agreement[]
  utilityBills UtilityBill[]

  @@index([ownerId])
  @@index([status])
  @@map("properties")
}

model Unit {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  unitName      String   @map("unit_name")
  unitType      UnitType @map("unit_type")
  squareFootage Float    @map("square_footage")
  occupantCount Int      @default(1) @map("occupant_count")

  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  priceLocks PriceLock[]
  utilityAllocations UtilityAllocation[]

  @@map("units")
}

// ─── Services ───────────────────────────────────────────────────────

model ServiceType {
  id           String      @id @default(uuid())
  name         String      @unique
  description  String
  basePrice    Decimal     @map("base_price") @db.Decimal(10, 2)
  priceUnit    PriceUnit   @default(FLAT) @map("price_unit")
  pricingRules Json        @map("pricing_rules")
  isActive     Boolean     @default(true) @map("is_active")

  quotes      Quote[]
  agreements  Agreement[]
  assignments Assignment[]
  priceLocks  PriceLock[]

  @@map("service_types")
}

// ─── Provider Side ──────────────────────────────────────────────────

model ProviderProfile {
  id                String              @id @default(uuid())
  userId            String              @unique @map("user_id")
  user              User                @relation(fields: [userId], references: [id])
  businessName      String              @map("business_name")
  verification      VerificationStatus  @default(PENDING)
  serviceCategories String[]            @map("service_categories")
  operationalZones  String[]            @map("operational_zones")
  latitude          Float?
  longitude         Float?
  location          Unsupported("geometry(Point, 4326)")?
  serviceRadiusKm   Int                 @default(10) @map("service_radius_km")
  maxConcurrent     Int                 @default(3) @map("max_concurrent")
  currentLoad       Int                 @default(0) @map("current_load")
  baseScore         Float               @default(50) @map("base_score")
  rating            Float               @default(0)
  completedJobs     Int                 @default(0) @map("completed_jobs")
  totalJobs         Int                 @default(0) @map("total_jobs")
  acceptanceRate    Float               @default(0) @map("acceptance_rate")
  responsiveness    Float               @default(0)
  strikeCount       Int                 @default(0) @map("strike_count")
  suspendedUntil    DateTime?           @map("suspended_until")
  mobileMoneyNumber String?             @map("mobile_money_number")

  assignments  Assignment[]
  wallet       Wallet?
  strikes      ProviderStrike[]
  blockedDates ProviderBlockedDate[]

  @@index([latitude, longitude])
  @@index([verification, baseScore])
  @@map("provider_profiles")
}

model ProviderStrike {
  id         String           @id @default(uuid())
  providerId String           @map("provider_id")
  reason     String
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@map("provider_strikes")
}

// ─── Quotes ─────────────────────────────────────────────────────────

model Quote {
  id               String       @id @default(cuid())
  ownerId          String       @map("owner_id")
  owner            User         @relation(fields: [ownerId], references: [id])
  propertyId       String       @map("property_id")
  property         Property     @relation(fields: [propertyId], references: [id])
  serviceTypeId    String       @map("service_type_id")
  serviceType      ServiceType  @relation(fields: [serviceTypeId], references: [id])
  quotedPrice      Decimal      @map("quoted_price") @db.Decimal(10, 2)
  frequency        ServiceFrequency @default(ONE_TIME)
  unitCount        Int          @default(1) @map("unit_count")
  priceLockedUntil DateTime?    @map("price_locked_until")
  status           QuoteStatus  @default(DRAFT)
  agreement        Agreement?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([status, priceLockedUntil])
  @@map("quotes")
}

// ─── Agreements (Owner ↔ Oweru contract) ────────────────────────────

model Agreement {
  id              String           @id @default(cuid())
  quoteId         String           @unique @map("quote_id")
  quote           Quote            @relation(fields: [quoteId], references: [id])
  ownerId         String           @map("owner_id")
  owner           User             @relation(fields: [ownerId], references: [id])
  propertyId      String           @map("property_id")
  property        Property         @relation(fields: [propertyId], references: [id])
  serviceTypeId   String           @map("service_type_id")
  serviceType     ServiceType      @relation(fields: [serviceTypeId], references: [id])
  quotedPrice     Decimal          @map("quoted_price") @db.Decimal(10, 2)
  frequency       ServiceFrequency @default(ONE_TIME)
  status          AgreementStatus  @default(QUOTED)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  assignment Assignment?
  invoice    Invoice?

  @@index([status])
  @@map("agreements")
}

// ─── Invoices (Oweru → Owner billing) ───────────────────────────────

model Invoice {
  id           String        @id @default(uuid())
  agreementId  String        @unique @map("agreement_id")
  amount       Decimal       @db.Decimal(10, 2)
  status       InvoiceStatus @default(PENDING)
  attempts     Int           @default(0)
  dueAt        DateTime      @map("due_at")
  paidAt       DateTime?     @map("paid_at")
  paymentRef   String?       @map("payment_reference")
  suspendedAt  DateTime?     @map("suspended_at")
  cancelledAt  DateTime?     @map("cancelled_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  agreement Agreement @relation(fields: [agreementId], references: [id])

  @@index([status])
  @@index([dueAt])
  @@map("invoices")
}

// ─── Assignment (Oweru ↔ Provider work order) ───────────────────────

model Assignment {
  id              String           @id @default(uuid())
  agreementId     String           @unique @map("agreement_id")
  agreement       Agreement        @relation(fields: [agreementId], references: [id])
  status          AssignmentStatus @default(PENDING_ACCEPTANCE)
  providerId      String?          @map("provider_id")
  provider        ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  propertyId      String           @map("property_id")
  property        Property         @relation(fields: [propertyId], references: [id])
  serviceTypeId   String           @map("service_type_id")
  serviceType     ServiceType      @relation(fields: [serviceTypeId], references: [id])

  // Financial breakdown (immutable post-acceptance)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(10, 2)
  providerPayout  Decimal          @map("provider_payout") @db.Decimal(10, 2)
  platformFee     Decimal          @map("platform_fee") @db.Decimal(10, 2)

  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  scheduledDate   DateTime?        @map("scheduled_date")
  completedAt     DateTime?        @map("completed_at")
  verifiedAt      DateTime?        @map("verified_at")
  cancelledAt     DateTime?        @map("cancelled_at")
  cancelReason    String?          @map("cancel_reason")
  transitionedAt  DateTime?        @map("transitioned_at")
  version         Int              @default(0)

  // Dispute
  disputedAt      DateTime?           @map("disputed_at")
  disputeReason   String?             @map("dispute_reason")
  disputeResolved DateTime?           @map("dispute_resolved_at")
  resolution      DisputeResolution?

  tasks Task[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([providerId, status])
  @@index([status, expiresAt])
  @@map("assignments")
}

// ─── Tasks (recurring per Assignment) ───────────────────────────────

model Task {
  id                       String      @id @default(uuid())
  assignmentId             String      @map("assignment_id")
  assignment               Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scheduledFor             DateTime    @map("scheduled_for")
  status                   TaskStatus  @default(SCHEDULED)
  checkInTime              DateTime?   @map("check_in_time")
  checkOutTime             DateTime?   @map("check_out_time")
  checkInLatitude          Float?      @map("check_in_latitude")
  checkInLongitude         Float?      @map("check_in_longitude")
  checkInLocation          Unsupported("geometry(Point, 4326)")?
  checkInMethod            String?     @map("check_in_method")
  evidenceImages           String[]    @default([]) @map("evidence_images")
  notes                    String?
  pendingPhotoVerification Boolean     @default(false) @map("pending_photo_verification")
  manualReviewReason       String?     @map("manual_review_reason")
  manualReviewRequestedAt  DateTime?   @map("manual_review_requested_at")
  overdueFlaggedAt         DateTime?   @map("overdue_flagged_at")
  verifiedAt               DateTime?   @map("verified_at")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")

  dispute Dispute?

  @@unique([assignmentId, scheduledFor])
  @@index([scheduledFor, status])
  @@index([status, overdueFlaggedAt])
  @@map("tasks")
}

// ─── Disputes ───────────────────────────────────────────────────────

model Dispute {
  id            String             @id @default(uuid())
  taskId        String             @unique @map("task_id")
  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reason        String
  evidence      Json?
  hasPII        Boolean            @default(false) @map("has_pii")
  piiTypes      String[]           @default([]) @map("pii_types")
  status        DisputeStatus      @default(OPEN)
  resolution    Json?
  resolutionType DisputeResolution? @map("resolution_type")
  staffTicketId String?            @unique @map("staff_ticket_id")
  staffTicket   StaffTicket?       @relation(fields: [staffTicketId], references: [id])
  createdAt     DateTime           @default(now()) @map("created_at")
  expiresAt     DateTime           @map("expires_at")
  resolvedAt    DateTime?          @map("resolved_at")

  @@index([status, expiresAt])
  @@map("disputes")
}

// ─── Financial Core ─────────────────────────────────────────────────

model Wallet {
  id               String   @id @default(uuid())
  providerId       String   @unique @map("provider_id")
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(12, 2)
  pendingBalance   Decimal  @default(0) @map("pending_balance")   @db.Decimal(12, 2)
  totalEarned      Decimal  @default(0) @map("total_earned")      @db.Decimal(12, 2)
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  provider     ProviderProfile     @relation(fields: [providerId], references: [id])
  transactions WalletTransaction[]
  alerts       ReconciliationAlert[]
  withdrawals  Withdrawal[]

  @@map("wallets")
}

model WalletTransaction {
  id             String            @id @default(uuid())
  walletId       String            @map("wallet_id")
  type           TransactionType
  amount         Decimal           @db.Decimal(12, 2)
  reference      String
  status         TransactionStatus @default(PENDING)
  runningBalance Decimal           @default(0) @map("running_balance") @db.Decimal(12, 2)
  createdAt      DateTime          @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@index([reference])
  @@map("wallet_transactions")
}

model Withdrawal {
  id           String   @id @default(uuid())
  walletId     String   @map("wallet_id")
  amount       Decimal  @db.Decimal(12, 2)
  status       String   @default("PENDING") // PENDING | APPROVED | PAID | FAILED | CANCELLED
  mobileNumber String   @map("mobile_number")
  paymentRef   String?  @map("payment_reference")
  requestedAt  DateTime @default(now()) @map("requested_at")
  processedAt  DateTime? @map("processed_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
  @@map("withdrawals")
}

/// Tracks platform's 20% commission revenue per assignment.
model PlatformRevenue {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  amount       Decimal  @db.Decimal(12, 2)
  reference    String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([assignmentId])
  @@map("platform_revenue")
}

model PriceLock {
  id            String   @id @default(uuid())
  propertyId    String   @map("property_id")
  serviceTypeId String   @map("service_type_id")
  unitId        String   @map("unit_id")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  property    Property    @relation(fields: [propertyId], references: [id])
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])
  unit        Unit        @relation(fields: [unitId], references: [id])

  @@unique([propertyId, serviceTypeId, unitId])
  @@index([expiresAt])
  @@map("price_locks")
}

model FinancialAuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityId])
  @@map("financial_audit_logs")
}

model ProcessedWebhook {
  id          String   @id @default(uuid())
  externalId  String   @unique @map("external_id")
  eventType   String   @map("event_type")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhooks")
}

model ReconciliationAlert {
  id            String    @id @default(uuid())
  walletId      String    @map("wallet_id")
  ledgerSum     Decimal   @map("ledger_sum")      @db.Decimal(12, 2)
  actualBalance Decimal   @map("actual_balance")  @db.Decimal(12, 2)
  delta         Decimal   @map("delta")           @db.Decimal(12, 2)
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, resolvedAt])
  @@map("reconciliation_alerts")
}

// ─── Staff Support ──────────────────────────────────────────────────

model StaffTicket {
  id         String         @id @default(uuid())
  type       TicketType
  priority   TicketPriority
  title      String
  content    Json
  status     TicketStatus   @default(PENDING)
  assignedTo String?        @map("assigned_to")
  resolvedAt DateTime?      @map("resolved_at")
  resolution Json?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  dispute Dispute?

  @@index([status, assignedTo])
  @@index([priority, status])
  @@map("staff_tickets")
}

// ─── Notifications ──────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  recipientId String   @map("recipient_id")
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  channel     String   // EMAIL | SMS | IN_APP | PUSH
  event       String
  payload     Json
  isRead      Boolean  @default(false) @map("is_read")
  sentAt      DateTime? @map("sent_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([recipientId, isRead])
  @@map("notifications")
}

// ─── Audit ──────────────────────────────────────────────────────────

model AuditEvent {
  id         String       @id @default(cuid())
  actorId    String?      @map("actor_id")
  actor      User?        @relation("AuditActor", fields: [actorId], references: [id])
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  action     AuditAction
  oldValue   Json?        @map("old_value")
  newValue   Json?        @map("new_value")
  hashChain  String?      @map("hash_chain")
  timestamp  DateTime     @default(now())

  @@index([entityType, entityId, timestamp])
  @@map("audit_events")
}

// ─── Utility Management ─────────────────────────────────────────────

model UtilityBill {
  id              String           @id @default(uuid())
  propertyId      String           @map("property_id")
  type            UtilityType
  amount          Decimal          @db.Decimal(10, 2)
  billingPeriod   String           @map("billing_period")
  allocationMethod AllocationMethod @map("allocation_method")
  documentUrl     String?          @map("document_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  property    Property             @relation(fields: [propertyId], references: [id])
  allocations UtilityAllocation[]

  @@index([propertyId, type])
  @@map("utility_bills")
}

model UtilityAllocation {
  id            String   @id @default(uuid())
  utilityBillId String   @map("utility_bill_id")
  unitId        String   @map("unit_id")
  amount        Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  utilityBill UtilityBill @relation(fields: [utilityBillId], references: [id], onDelete: Cascade)
  unit        Unit        @relation(fields: [unitId], references: [id])

  @@unique([utilityBillId, unitId])
  @@map("utility_allocations")
}

model ProviderBlockedDate {
  id          String   @id @default(uuid())
  providerId  String   @map("provider_id")
  blockedDate DateTime @map("blocked_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, blockedDate])
  @@index([blockedDate])
  @@map("provider_blocked_dates")
}
